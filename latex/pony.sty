% ---------------------------------------------------------------- Buchfassung: Titelblatt, Bogenfüllung
% \fwbooktitle{Titel}{Untertitel}{Bild} – Titelblatt mit leerer Rückseite; Bild leer = ohne Bild
\newcommand\fwbooktitle[3]{%
  \gdef\fwpagekind{blank}%
  \begingroup\centering
  \null\vspace{36mm}%
  {\fontsize{38}{44}\selectfont\bfseries\color{fwred}#1\par}%
  \vspace{6mm}{\color{fwred}\hrule height 1.2pt}\vspace{6mm}%
  {\fontsize{13}{18}\selectfont\itshape\color{fwgrey}#2\par}%
  \vspace{14mm}%
  \ifblank{#3}{}{\includegraphics[width=\linewidth]{#3}\par}
  \vfill
  {\fontsize{9}{12}\selectfont\color{fwgrey}Version \fwversion\ · Stand \fwstand\par
   \fwcredit\par}%
  \endgroup
  \clearpage\null\clearpage
  \gdef\fwpagekind{normal}}
% Notizseiten anhängen, bis die Seitenzahl durch 4 teilbar ist (ganze Bogen)
\newcommand\fw@fill{%
  \@tempcnta=\c@page \advance\@tempcnta\m@ne
  \@tempcntb=\@tempcnta \divide\@tempcntb 4 \multiply\@tempcntb 4
  \ifnum\@tempcnta>\@tempcntb \null\clearpage\expandafter\fw@fill\fi}
\newcommand\fwfillsheets{\clearpage\gdef\fwpagekind{fill}\fw@fill}

\endinput
