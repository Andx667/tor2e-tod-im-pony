\newcommand\fw@bgportrait{%
  \fw@setside
  \iffw@left
    \iffwnotes\fw@notescolumn{68}{14}\fi
    \iffw@first\else\ifx\fwcurrent\@empty\else\fw@runninghead\fi\fi
    \fw@footer{14}{105}{184}%
  \else
    \iffwnotes\fw@notescolumn{142}{146}\fi
    \iffw@first\else\ifx\fwcurrent\@empty\else\fw@runninghead\fi\fi
    \fw@footer{26}{105}{196}%
  \fi}
\newcommand\fw@bglandscape{%
  \fw@leftfalse
  \ifdefstring{\fwpagekind}{handout}{%
    \put(285,5){\makebox(0,0)[rb]{\fontsize{6.5}{8}\selectfont\color{fwline}Version \fwversion\ · Stand \fwstand\ · \fwcredit}}%
  }{\fw@footer{14}{148.5}{283}}}

% Buchfassung: Querseite (297 × 210 mm) um 90° gedreht auf die Hochformatseite, Kopf nach
% links. Auf 93 % verkleinert; die gewonnenen 14,7 mm liegen innen am Bund.
\newcommand\fw@rotated[1]{%
  \fw@setside
  \edef\fw@rotx{\iffw@left 0\else 14.7\fi}%
  \put(\fw@rotx,10.4){\scalebox{0.93}{\rotatebox{90}{%
    \begin{picture}(297,210)#1\end{picture}}}}}
\newcommand\fw@landpic[1]{\iffw@book\fw@rotated{#1}\else#1\fi}

\AddToShipoutPictureBG{%
  \setlength\unitlength{1mm}%
  \ifdefstring{\fwpagekind}{blank}{}{%
    \ifdefstring{\fwpagekind}{fill}{\fw@notespage}{%
      \iffw@book
        \ifdefstring{\fwpagekind}{normal}{\fw@bgportrait}{\fw@rotated{\fw@bglandscape}}%
      \else
        \ifdim\paperwidth>\paperheight\fw@bglandscape\else\fw@bgportrait\fi
      \fi}}%
  \global\fw@firstfalse}

