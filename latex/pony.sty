% \fwchapter{notes|nonotes}{label}{Titel (LaTeX)}{Titel (Lesezeichen)}
\newcommand\fwchapter[4]{%
  \iffw@started
    \clearpage\fw@geometry{#1}%
  \else
    \global\fw@startedtrue
    \ifstrequal{#1}{notes}{\global\fwnotestrue}{\global\fwnotesfalse}%
  \fi
  \global\fw@firsttrue
  \gdef\fwcurrent{#3}%
  \phantomsection\pdfbookmark[0]{#4}{bm-#2}\label{#2}%
  \fw@heading{#3}}

