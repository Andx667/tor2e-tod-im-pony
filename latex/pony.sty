\newcommand\fwtitle[2]{%
  \noindent{\fontsize{24}{27}\selectfont\bfseries\color{fwred}#1\par}%
  \vspace{1mm}{\itshape\color{fwgrey}#2\par}%
  \vspace{2.5mm}{\color{fwred}\hrule height 1.2pt}\vspace{2mm}}

\newcommand\fw@heading[1]{%
  {\fontsize{15}{18}\selectfont\bfseries\color{fwred}#1\par}%
